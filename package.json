{
  "name": "@lirantal/typeform-client",
  "version": "0.0.0-development",
  "description": "A friendlier Typeform Node.js API client",
  "main": "index.js",
  "engines": {
    "npm": ">=11.10.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config .prettierrc.js --write '**/*.js'",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage:view": "open-cli coverage/lcov-report/index.html",
    "commit": "git-cz",
    "docs": "yarn run docs:code && yarn run docs:api",
    "docs:api": "doxdox *.js --layout bootstrap --output docs/index.html",
    "docs:code": "docco *.js --output docs/code",
    "build": "echo \"No build step configured\"",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml '**/**.md'",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "author": {
    "name": "Liran Tal",
    "email": "liran@snyk.io",
    "url": "https://github.com/lirantal"
  },
  "license": "Apache-2.0",
  "keywords": [
    "typeform",
    "client",
    "api",
    "sdk",
    "survey"
  ],
  "homepage": "https://github.com/lirantal/typeform-client",
  "bugs": {
    "url": "https://github.com/lirantal/typeform-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lirantal/typeform-client.git"
  },
  "dependencies": {
    "@typeform/api-client": "^2.4.1",
    "debug": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "docco": "^0.9.2",
    "doxdox": "^3.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "30.5",
    "lint-staged": "^17.6.0",
    "opn-cli": "^5.0.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "markdownlint-cli": "0.49.1",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-n": "^18.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "testPathIgnorePatterns": [
      "/__tests__/.*/__fixtures__/.*"
    ],
    "coveragePathIgnorePatterns": [
      "/__tests__/.*/__fixtures__/.*",
      "/__tests__/.*/__snapshots__/.*"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "snapshotFormat": {
      "printBasicPrototype": true,
      "escapeString": true
    }
  },
  "lint-staged": {
    "**/*.js": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
